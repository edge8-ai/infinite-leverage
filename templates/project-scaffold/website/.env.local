# Gitignored. Fill in the values below; never commit this file.
#
# This file is the only env-var list — CI checks that every process.env.*
# the app reads appears here, and that nothing uncommented is never read.
# Vars the app does not read yet stay commented out with a leading #; uncomment
# one in the same commit as the code that reads it.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. Both values are public by design and are sent to
# the browser. The project must live in {Supabase Region} (see CLAUDE.md → Stack →
# Region) so it sits next to the Vercel functions pinned in vercel.json.
NEXT_PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=            # sb_publishable_...
# SUPABASE_SECRET_KEY=            # server-side only, never NEXT_PUBLIC; needed for privileged writes
# SUPABASE_DB_PASSWORD=            # Project Settings → Database; for `supabase link` / `db push`, never read by the app

# ── Vercel ──────────────────────────────────────────────────────────────────
# The public origin: auth email redirects and SEO metadata. Set it per Vercel
# environment; locally it is http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# PRODUCTION_URL=            # https://yourdomain.com, the Vercel Production alias
# STAGING_URL=            # https://<project>-git-staging-<team>.vercel.app, the Preview alias for the staging branch
# VERCEL_URL and VERCEL_ENV are injected by Vercel at build time; do not set them here.
# AI_GATEWAY_API_KEY=            # only for local dev without `vercel env pull` (OIDC covers deploys)

# ── Resend ──────────────────────────────────────────────────────────────────
# resend.com → API Keys. EMAIL_FROM must be on a verified domain.
# RESEND_API_KEY=            # re_...
# EMAIL_FROM=            # "Name <hello@yourdomain.com>"

# ── Anthropic ───────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys. Server-side only.
# ANTHROPIC_API_KEY=            # sk-ant-...

# ── Stripe ──────────────────────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys / Webhooks. Test keys locally.
# STRIPE_SECRET_KEY=            # sk_test_... / sk_live_...
# STRIPE_WEBHOOK_SECRET=            # whsec_..., from the webhook endpoint
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=            # pk_test_... / pk_live_...
